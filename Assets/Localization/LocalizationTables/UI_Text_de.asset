  m_TableData:
  - m_Id: 568104837120
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 21365028544512
    m_Localized: Reinigen
    m_Metadata:
      m_Items: []
  - m_Id: 121660249202688
    m_Localized: Venue reinigen
    m_Metadata:
      m_Items: []
  - m_Id: 121812842176512
    m_Localized: "Ein sauberer Veranstaltungsort tekee hyv\xE4n ensivaikutelman."
    m_Metadata:
      m_Items: []
  - m_Id: 145795574652928
    m_Localized: Backstage ordnen
    m_Metadata:
      m_Items: []
  - m_Id: 145864755503104
    m_Localized: "Beseitige das Ausr\xFCstungschaos, damit Crew und Band schneller
      arbeiten k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 145970829451264
    m_Localized: Vorbereiten
    m_Metadata:
      m_Items: []
  - m_Id: 164314693492736
    m_Localized: "Hauptb\xFChne ausbauen"
    m_Metadata:
      m_Items: []
  - m_Id: 164363980759040
    m_Localized: "Baue eine gr\xF6\xDFere und stabilere B\xFChne f\xFCr deine Headliner."
    m_Metadata:
      m_Items: []
  - m_Id: 165051183915008
    m_Localized: Club-Deko
    m_Metadata:
      m_Items: []
  - m_Id: 165095949721600
    m_Localized: "Verwandle einen langweiligen Keller in ein legend\xE4res Rock-Paradies."
    m_Metadata:
      m_Items: []
  - m_Id: 165184000745472
    m_Localized: Leistungsstarke PA-Anlage
    m_Metadata:
      m_Items: []
  - m_Id: 165295678283776
    m_Localized: "Klare H\xF6hen und donnernder Bass bringen die erste Reihe zum
      Ausrasten."
    m_Metadata:
      m_Items: []
  - m_Id: 165338170777600
    m_Localized: "Dynamische B\xFChnenlichter"
    m_Metadata:
      m_Items: []
  - m_Id: 165384287150080
    m_Localized: Blende sie mit epischen Strobos und Laser-Shows.
    m_Metadata:
      m_Items: []
  - m_Id: 165447428202496
    m_Localized: "Publikumskapazit\xE4t"
    m_Metadata:
      m_Items: []
  - m_Id: 165513379438592
    m_Localized: "\xD6ffne die Tore, damit mehr Fans in den Moshpit passen."
    m_Metadata:
      m_Items: []
  - m_Id: 165565254590464
    m_Localized: Live-Gigs buchen
    m_Metadata:
      m_Items: []
  - m_Id: 165632246013952
    m_Localized: "Verpflichte lokale Talente f\xFCr ausverkaufte Shows."
    m_Metadata:
      m_Items: []
  - m_Id: 457357736796160
    m_Localized: Erster Eindruck
    m_Metadata:
      m_Items: []
  - m_Id: 457484400582656
    m_Localized: Platz schaffen
    m_Metadata:
      m_Items: []
  - m_Id: 457556827824128
    m_Localized: Im Rampenlicht
    m_Metadata:
      m_Items: []
  - m_Id: 457650356609024
    m_Localized: Die Stimmung setzen
    m_Metadata:
      m_Items: []
  - m_Id: 457749006639104
    m_Localized: Erleuchte die Nacht
    m_Metadata:
      m_Items: []
  - m_Id: 457775166513152
    m_Localized: Es spricht sich rum
    m_Metadata:
      m_Items: []
  - m_Id: 457817478651904
    m_Localized: Showtime
    m_Metadata:
      m_Items: []
